# Copie para .env na pasta saas/client-panel. Nao commite o .env.
# Sem MP_ACCESS_TOKEN o trial de 30 dias continua; o botao Assinar responde 503.

PORT=3847
JWT_SECRET=
MP_ACCESS_TOKEN=
PUBLIC_URL=https://seu-dominio
NAMY_PRICE_MENSAL=49
NAMY_PRICE_TRIMESTRAL=129
# RESTORE_SESSIONS=1

# --- Afiliados (nichos, Mercado Livre, Amazon, imagens) — veja AFILIADOS.md ---
# Cofre dos tokens de marketplace (AES-256-GCM). 32+ caracteres. Sem ela o OAuth do ML fica desligado.
SAAS_MASTER_KEY=
# App do Mercado Livre (developers.mercadolivre.com.br). Redirect = PUBLIC_URL/mercadolivre/callback
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# ML_REDIRECT_URI=https://seu-dominio/mercadolivre/callback
# Imagens por cenario (opcional). Sem a chave a aba Imagens so mostra as fotos.
GEMINI_API_KEY=
# NAMY_IMAGE_MODEL=gemini-2.5-flash-image
# NAMY_IMAGE_DAILY=20

# Diagnostico da captura: grava metadados de mensagens de grupo em api/data/captura-debug.jsonl
# NAMY_DEBUG_CAPTURA=1

# IA local (Ollama) como opcao do DONO. So as contas em NAMY_OLLAMA_EMAILS podem usar;
# os demais clientes usam a propria chave (Groq, Grok ou Gemini) na pagina de IA.
# NAMY_OLLAMA_URL=http://127.0.0.1:11434
# NAMY_OLLAMA_MODEL=qwen3.5:4b
# NAMY_OLLAMA_EMAILS=dono@exemplo.com
