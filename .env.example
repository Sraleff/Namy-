# Chaves de IA da CASA — use pelo menos uma. Clientes usam as próprias (via !minhaconta).
GROQ_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Números dos donos (DDI+DDD+número, separados por vírgula). Sem @s.whatsapp.net.
OWNERS=5511999999999

# Chave mestra do cofre de chaves dos clientes (mínimo 32 caracteres, aleatória).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SE PERDER ou TROCAR, as chaves salvas dos clientes viram lixo e eles precisam cadastrar de novo.
SAAS_MASTER_KEY=

# Painel SaaS MVP (saas/mvp) — link de afiliado via !link
# Suba o painel: cd saas/mvp && npm install && npm start
NAMY_SAAS_URL=http://localhost:3847
NAMY_BOT_TOKEN=

# Modelos (opcional)
# IA_MODEL_GROQ=openai/gpt-oss-20b
# IA_MODEL_XAI=grok-4.6
# IA_MODEL_GEMINI=gemini-2.0-flash

# Segurança (opcional)
# IGNORE_JIDS=120363142999607164@g.us
# RATE_LIMIT_MAX=8
# RATE_LIMIT_WINDOW_SEC=60

# Shopee da CASA (opcional se só houver clientes com chave própria).
# https://affiliate.shopee.com.br/open_api
SHOPEE_APP_ID=
SHOPEE_SECRET=
# SHOPEE_ENABLED=false
# SHOPEE_KEYWORD=fone bluetooth
