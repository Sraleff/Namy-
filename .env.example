# Chaves de IA — use pelo menos uma. Com duas ou três o fallback fica automático.
GROQ_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Números dos donos (DDI+DDD+número, separados por vírgula). Sem @s.whatsapp.net.
OWNERS=5511999999999

# Modelos (opcional)
# IA_MODEL_GROQ=openai/gpt-oss-20b
# IA_MODEL_XAI=grok-4.6
# IA_MODEL_GEMINI=gemini-2.0-flash

# Segurança (opcional)
# Chats ignorados, separados por vírgula
# IGNORE_JIDS=120363142999607164@g.us
# Anti-flood: máximo de comandos por pessoa dentro da janela (segundos)
# RATE_LIMIT_MAX=8
# RATE_LIMIT_WINDOW_SEC=60

# Shopee Affiliate Open API (Brasil).
# AppId e Secret saem do painel oficial: https://affiliate.shopee.com.br/open_api
# Sem as duas chaves o módulo Shopee fica desligado e o resto da Namy segue.
SHOPEE_APP_ID=
SHOPEE_SECRET=
# SHOPEE_ENABLED=false
# SHOPEE_KEYWORD=fone bluetooth
